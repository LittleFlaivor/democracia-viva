rules_version = '2';

/**
 * REGLAS DE SEGURIDAD ESTRICTAS DE FIRESTORE: PROTOCOLO DEMOCRACIA VIVA
 * Garantizan a nivel de servidor:
 * 1. Separación física estricta entre Producción (prod_*) y Simulación (sandbox_*).
 * 2. Censo de Participación (Participation_Roll): 1 ciudadano = 1 voto, firma WebAuthn obligatoria.
 * 3. Urna Anónima Desacoplada (Ballot_Box): CERO PII, CERO nullifiers, CERO IPs.
 * 4. Inmutabilidad radical: No rollback, no updates destructivos, no borrados.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para validar esquema de Censo de Participación
    function isValidRollRecord() {
      let data = request.resource.data;
      return data.keys().hasAll(['roll_id', 'consultation_id', 'citizen_nullifier_hash', 'status', 'webauthn_assertion_signature', 'hour_bucket'])
        && (data.status in ['VOTED_DIRECT', 'DELEGATED'])
        && data.webauthn_assertion_signature is string
        && data.webauthn_assertion_signature.size() >= 16;
    }

    // Función auxiliar para validar que la Urna no contenga PII ni claves del censo
    function isZeroPiiBallotBox() {
      let data = request.resource.data;
      return !data.keys().hasAny(['citizen_nullifier_hash', 'user_id', 'ip', 'dni', 'name', 'email']);
    }

    // ───────────────── CENSO DE PARTICIPACIÓN (PROD & SANDBOX) ─────────────────
    match /prod_participation_roll/{rollId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/prod_participation_roll/$(rollId))
                    && request.resource.data.roll_id == rollId
                    && isValidRollRecord();
      allow update, delete: if false;
    }

    match /sandbox_participation_roll/{rollId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/sandbox_participation_roll/$(rollId))
                    && request.resource.data.roll_id == rollId
                    && isValidRollRecord();
      allow update, delete: if false;
    }

    // ───────────────── URNA SECRETA ANTI-FORENSE SHARDEADA (PROD & SANDBOX) ─────────────────
    match /prod_ballot_box/{shardId} {
      allow read: if true;
      allow create, update: if isZeroPiiBallotBox();
      allow delete: if false;
    }

    match /sandbox_ballot_box/{shardId} {
      allow read: if true;
      allow create, update: if isZeroPiiBallotBox();
      allow delete: if true; // Permitido solo en sandbox para el botón "Reset Sandbox"
    }

    // ───────────────── COMPATIBILIDAD CON VISTAS PREVIAS Y TEST RUNNERS ─────────────────
    function isValidVotePayload() {
      let data = request.resource.data;
      return data.keys().hasAll(['nullifierHash', 'proposalId', 'choice', 'timestamp'])
        && data.keys().hasOnly(['nullifierHash', 'proposalId', 'choice', 'timestamp', 'clientSignature', 'merkleLeaf', 'txHash', 'receiptId', 'merkleRoot'])
        && (data.choice in ['YES', 'NO', 'DELEGATE'])
        && data.nullifierHash is string
        && data.proposalId is string
        && (data.timestamp is number || data.timestamp is timestamp);
    }

    match /users/{credentialId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['credentialId', 'publicKey', 'createdAt'])
                    && request.resource.data.credentialId == credentialId;
      allow update, delete: if false;
    }

    match /votes/{nullifierHash} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/votes/$(nullifierHash))
                    && request.resource.data.nullifierHash == nullifierHash
                    && isValidVotePayload();
      allow update, delete: if false;
    }
  }
}
